+
+func TestCallbackFallbackKeepsAListenerAndForwardsQuery(t *testing.T) {
+	occupied, err := net.Listen("tcp", "0.0.0.0:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer occupied.Close()
+	port := occupied.Addr().(*net.TCPAddr).Port
+	forwarder, err := startCallbackForwarderWithFallback(port, "antigravity", "http://127.0.0.1:8318/antigravity/callback")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stopCallbackForwarderInstance(forwarder.port, forwarder)
+	if forwarder.port == port || forwarder.port == 0 {
+		t.Fatalf("invalid fallback port: %d", forwarder.port)
+	}
+	if host, _, _ := net.SplitHostPort(forwarder.server.Addr); host != "127.0.0.1" {
+		t.Fatalf("non-loopback fallback: %s", host)
+	}
+	client := &http.Client{Transport: &http.Transport{Proxy: nil}, CheckRedirect: func(req *http.Request, via []*http.Request) error { return http.ErrUseLastResponse }}
+	response, err := client.Get("http://127.0.0.1:" + strconv.Itoa(forwarder.port) + "/oauth-callback?state=test-state&code=test-code")
+	if err != nil {
+		t.Fatal(err)
+	}
+	response.Body.Close()
+	if response.StatusCode != http.StatusFound {
+		t.Fatalf("status %d", response.StatusCode)
+	}
+	if response.Header.Get("Location") != "http://127.0.0.1:8318/antigravity/callback?state=test-state&code=test-code" {
+		t.Fatal("callback query not preserved")
+	}
+	if response.Header.Get("Cache-Control") != "no-store" {
+		t.Fatal("callback must not be cached")
+	}
+}
+
+func TestCallbackPreferredPortStaysCompatible(t *testing.T) {
+	forwarder, err := startCallbackForwarderWithFallback(0, "antigravity", "http://127.0.0.1:8318/antigravity/callback")
+	if err != nil {
+		t.Fatal(err)
+	}
+	port := forwarder.port
+	stopCallbackForwarderInstance(port, forwarder)
+	forwarder, err = startCallbackForwarderWithFallback(port, "antigravity", "http://127.0.0.1:8318/antigravity/callback")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stopCallbackForwarderInstance(forwarder.port, forwarder)
+	if forwarder.port != port {
+		t.Fatalf("preferred port %d was ignored", port)
+	}
+}
+
+func TestRequestAntigravityUsesActualCallbackPort(t *testing.T) {
+	// A occupied port also reproduces Windows' reserved-port bind failure.
+	occupied, err := net.Listen("tcp", "0.0.0.0:"+strconv.Itoa(antigravity.CallbackPort))
+	if err == nil {
+		defer occupied.Close()
+	}
+	handler := NewHandlerWithoutConfigFilePath(&config.Config{Port: 8318, AuthDir: t.TempDir()}, nil)
+	router := gin.New()
+	router.GET("/antigravity-auth-url", handler.RequestAntigravityToken)
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, httptest.NewRequest(http.MethodGet, "/antigravity-auth-url?is_webui=true", nil))
+	if response.Code != http.StatusOK {
+		t.Fatalf("auth URL request returned %d", response.Code)
+	}
+	var result struct {
+		URL   string `json:"url"`
+		State string `json:"state"`
+	}
+	if err := json.Unmarshal(response.Body.Bytes(), &result); err != nil {
+		t.Fatal(err)
+	}
+	defer CompleteOAuthSession(result.State)
+	authURL, err := url.Parse(result.URL)
+	if err != nil {
+		t.Fatal(err)
+	}
+	redirect, err := url.Parse(authURL.Query().Get("redirect_uri"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	port, err := strconv.Atoi(redirect.Port())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if port == antigravity.CallbackPort {
+		t.Fatal("auth URL still uses the unavailable callback port")
+	}
+	callbackForwardersMu.Lock()
+	forwarder := callbackForwarders[port]
+	callbackForwardersMu.Unlock()
+	if forwarder == nil {
+		t.Fatal("advertised port has no callback listener")
+	}
+	defer stopCallbackForwarderInstance(port, forwarder)
+	if redirect.Scheme != "http" || redirect.Hostname() != "localhost" || redirect.Path != "/oauth-callback" {
+		t.Fatal("invalid callback URL")
+	}
+	if authURL.Host != "accounts.google.com" || authURL.Query().Get("state") != result.State {
+		t.Fatal("invalid Google auth URL")
+	}
+}
