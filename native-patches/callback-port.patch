+// Windows can reserve an otherwise unused callback port (WSAEACCES). Keep
+// browser login working by holding a loopback listener on an OS-selected port.
+func startCallbackForwarderWithFallback(port int, provider, targetBase string) (*callbackForwarder, error) {
+	forwarder, err := startCallbackForwarder(port, provider, targetBase)
+	if err == nil {
+		return forwarder, nil
+	}
+	ln, errFallback := net.Listen("tcp", "127.0.0.1:0")
+	if errFallback != nil {
+		return nil, fmt.Errorf("callback port unavailable: %w; fallback: %v", err, errFallback)
+	}
+	return startCallbackForwarderListener(ln, provider, targetBase), nil
+}
